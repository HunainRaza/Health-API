									"mode": "raw",
									"raw": "{\r\n    \"email\": \"{{$randomEmail}}\",\r\n    \"password1\": \"SecurePass123!\",\r\n    \"first_name\": \"{{$randomFirstName}}\",\r\n    \"last_name\": \"{{$randomLastName}}\",\r\n    \"phone\": \"{{$randomPhoneNumber}}\",\r\n    \"user_type\": \"patient\",\r\n    \"date_of_birth\": \"1990-05-15\",\r\n    \"blood_type\": \"O+\",\r\n    \"emergency_contact_name\": \"{{$randomFullName}}\",\r\n    \"emergency_contact_phone\": \"{{$randomPhoneNumber}}\",\r\n    \"medical_history\": \"{{$randomJobDescriptor}}\"\r\n}",
									"options": {
										"raw": {
