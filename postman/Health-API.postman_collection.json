						},
						{
							"name": "Patient Login",
							"event": [
								{
									"listen": "test",
									"script": {
										"exec": [
											"if (pm.response.code === 200) {\r",
											"    var responseJson = pm.response.json();\r",
											"    \r",
											"    // Save main token\r",
											"    pm.environment.set(\"Auth-Token\", responseJson.token);\r",
											"    \r",
											"    // Save user-type specific tokens\r",
											"    if (responseJson.user_type === \"patient\") {\r",
											"        pm.environment.set(\"patient_token\", \"Token \" + responseJson.token);\r",
											"        pm.environment.set(\"patient_email\", responseJson.email);\r",
											"        pm.environment.set(\"patient_password\", responseJson.password);\r",
											"    } else if (responseJson.user_type === \"doctor\") {\r",
											"        pm.environment.set(\"doctor_token\", \"Token \" + responseJson.token);\r",
											"    }\r",
											"    \r",
											"    console.log(\"Token saved for \" + responseJson.user_type);\r",
											"}"
										],
										"type": "text/javascript",
										"packages": {}
									}
								}
							],
							"request": {
								"method": "POST",
								"header": [],
								"body": {
									"mode": "raw",
									"raw": "{\r\n    \"email\": \"kobe38@yahoo.com\",\r\n    \"password\": \"SecurePass123!\"\r\n}",
